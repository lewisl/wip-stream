{
  "name": "wipstream",
  "displayName": "WipStream",
  "publisher": "lewisl",
  "description": "A deliberate Git handoff workflow for moving one feature safely between computers.",
  "version": "0.1.7",
  "extensionKind": ["workspace"],
  "repository": {
    "type": "git",
    "url": "https://github.com/lewisl/wip-stream.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "keywords": ["git", "sync", "handoff", "workflow"],
  "activationEvents": [
    "onCommand:wipstream.init",
    "onCommand:wipstream.resume",
    "onCommand:wipstream.saveup",
    "onCommand:wipstream.tofeature",
    "onCommand:wipstream.tomain"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {"command": "wipstream.init", "title": "Initialize Stream", "category": "WipStream"},
      {"command": "wipstream.resume", "title": "Get Current from Remote", "category": "WipStream"},
      {"command": "wipstream.saveup", "title": "Save to Remote", "category": "WipStream"},
      {"command": "wipstream.tofeature", "title": "To Feature", "category": "WipStream"},
      {"command": "wipstream.tomain", "title": "To Main", "category": "WipStream"}
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node test/workflow.test.js",
    "test:live": "npm run package && node test/live.js",
    "test:live:verify": "node test/live.js --verify",
    "test:live:cleanup": "node test/live.js --cleanup",
    "package": "npm run compile && vsce package --out dist/lewisl.wipstream-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/node": "^18.6.5",
    "@types/vscode": "1.90.0",
    "typescript": "^4.7.4",
    "vsce": "^2.10.0"
  },
  "dependencies": {}
}
