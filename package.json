{
  "name": "wipstream",
  "displayName": "WipStream",
  "publisher": "lewisl",
  "description": "Use git to synchronize feature development across several computers.",
  "version": "0.1.8",
  "extensionKind": [
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lewisl/wip-stream.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "sync",
    "synchronize",
    "development"
  ],
  "activationEvents": [
    "onCommand:wipstream.init",
    "onCommand:wipstream.resume",
    "onCommand:wipstream.saveup",
    "onCommand:wipstream.tofeature",
    "onCommand:wipstream.tomain"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wipstream.init",
        "title": "Initialize Stream",
        "category": "WipStream"
      },
      {
        "command": "wipstream.resume",
        "title": "Get Current from Remote",
        "category": "WipStream"
      },
      {
        "command": "wipstream.saveup",
        "title": "Save to Remote",
        "category": "WipStream"
      },
      {
        "command": "wipstream.tofeature",
        "title": "To Feature",
        "category": "WipStream"
      },
      {
        "command": "wipstream.tomain",
        "title": "To Main",
        "category": "WipStream"
      }
    ],
    "keybindings": [
      {
        "command": "wipstream.init",
        "key": "ctrl+w i"
      },
      {
        "command": "wipstream.resume",
        "key": "ctrl+w g"
      },
      {
        "command": "wipstream.saveup",
        "key": "ctrl+w s"
      },
      {
        "command": "wipstream.tofeature",
        "key": "ctrl+w f"
      },
      {
        "command": "wipstream.tomain",
        "key": "ctrl+w m"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node test/workflow.test.js && node test/v1-characterization.test.js && node test/repository-model.test.js && node test/repository-safety.test.js && node test/operations.test.js",
    "test:live": "npm run package && node test/live.js",
    "test:live:verify": "node test/live.js --verify",
    "test:live:cleanup": "node test/live.js --cleanup",
    "package": "npm run compile && vsce package --out dist/lewisl.wipstream-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/node": "^18.6.5",
    "@types/vscode": "1.90.0",
    "typescript": "^4.7.4",
    "vsce": "^2.10.0"
  },
  "dependencies": {
    "@firecrawl/anydoc-wasm": "^0.1.9"
  }
}
