{
  "name": "wipstream",
  "displayName": "WipStream",
  "publisher": "lewisl",
  "description": "Use git to synchronize feature development across several computers.",
  "version": "0.2.8",
  "extensionKind": [
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lewisl/wip-stream.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "sync",
    "synchronize",
    "development"
  ],
  "activationEvents": [
    "onCommand:wipstream.init",
    "onCommand:wipstream.resume",
    "onCommand:wipstream.saveup",
    "onCommand:wipstream.start",
    "onCommand:wipstream.finish",
    "onCommand:wipstream.update",
    "onCommand:wipstream.reconcile",
    "onCommand:wipstream.continue",
    "onCommand:wipstream.abort",
    "onCommand:wipstream.recover",
    "onCommand:wipstream.undo",
    "onCommand:wipstream.condense"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wipstream.init",
        "title": "Initialize Repository",
        "category": "WipStream"
      },
      {
        "command": "wipstream.resume",
        "title": "Get from Remote",
        "category": "WipStream"
      },
      {
        "command": "wipstream.saveup",
        "title": "Commit and Save",
        "category": "WipStream"
      },
      {
        "command": "wipstream.start",
        "title": "Start Branch",
        "category": "WipStream"
      },
      {
        "command": "wipstream.finish",
        "title": "Finish Branch",
        "category": "WipStream"
      },
      {
        "command": "wipstream.update",
        "title": "Update from Parent",
        "category": "WipStream"
      },
      {
        "command": "wipstream.reconcile",
        "title": "Reconcile with Remote",
        "category": "WipStream"
      },
      {
        "command": "wipstream.continue",
        "title": "Continue Pending Merge",
        "category": "WipStream"
      },
      {
        "command": "wipstream.abort",
        "title": "Abort Pending Merge",
        "category": "WipStream"
      },
      {
        "command": "wipstream.recover",
        "title": "Recover Incomplete Operation",
        "category": "WipStream"
      },
      {
        "command": "wipstream.undo",
        "title": "Undo Last Action",
        "category": "WipStream"
      },
      {
        "command": "wipstream.condense",
        "title": "Condense Branch (Advanced)",
        "category": "WipStream"
      }
    ],
    "keybindings": [
      {
        "command": "wipstream.init",
        "key": "ctrl+w i"
      },
      {
        "command": "wipstream.resume",
        "key": "ctrl+w g"
      },
      {
        "command": "wipstream.saveup",
        "key": "ctrl+w s"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "wipstream.start"
        },
        {
          "command": "wipstream.finish"
        },
        {
          "command": "wipstream.update"
        },
        {
          "command": "wipstream.reconcile"
        },
        {
          "command": "wipstream.continue"
        },
        {
          "command": "wipstream.abort"
        },
        {
          "command": "wipstream.recover"
        },
        {
          "command": "wipstream.undo",
          "when": "wipstream.undoAvailable"
        },
        {
          "command": "wipstream.condense",
          "when": "wipstream.condenseAvailable"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node test/git.test.js && node test/repository-model.test.js && node test/repository-safety.test.js && node test/operations.test.js && node test/get-from-remote.test.js && node test/initialize-repository.test.js && node test/commit-and-save.test.js && node test/setup-inspection.test.js && node test/setup-workflow.test.js && node test/project-backup.test.js && node test/remote-adoption.test.js && node test/remote-adoption-recovery.test.js && node test/lifecycle-workflow.test.js && node test/conflict-workflow.test.js && node test/recovery-workflow.test.js && node test/undo-workflow.test.js && node test/command-surface.test.js && node test/command-context.test.js && node test/setup-ui.test.js",
    "test:live": "npm run package && node test/live.js",
    "test:live:verify": "node test/live.js --verify",
    "test:live:cleanup": "node test/live.js --cleanup",
    "test:setup-usage": "npm run compile && node test/setup-usage.js",
    "package": "npm run compile && vsce package --out dist/lewisl.wipstream-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/node": "^18.6.5",
    "@types/vscode": "1.90.0",
    "typescript": "^4.7.4",
    "vsce": "^2.10.0"
  }
}
